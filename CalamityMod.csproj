<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\tModLoader.targets" Condition="Exists('..\tModLoader.targets')" />
  <Import Project="..\tModLoader\tModLoader.targets" Condition="!Exists('..\tModLoader.targets')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CalamityMod</AssemblyName>
    <ExpectedModSourceDirectoryName>CalamityMod</ExpectedModSourceDirectoryName>
    <ActualModSourceDirectoryName>$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</ActualModSourceDirectoryName>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

    <!-- Taken from: <https://github.com/krafs/Publicizer/pull/128>.  This is
         used to fix an annoying warning because the publicizer we're using
         emits a type also included by MonoMod.Utils. -->
  <Target Name="RemoveIgnoresAccessChecksToAttributeCs" AfterTargets="PublicizeAssemblies">
    <ItemGroup>
      <FilesToRemove Include="@(Compile)" Condition="'%(Filename)' == 'IgnoresAccessChecksToAttribute'" />
    </ItemGroup>
    <ItemGroup>
      <Compile Remove="@(FilesToRemove)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Publicize Include="tModLoader" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
    <DoNotPublicize Include="tModLoader:Terraria.Tile" /> 

    <Publicize Include="FNA" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
    <Publicize Include="ReLogic" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
  </ItemGroup>

  <!-- .NET 10 project references retain their original ref assembly after
       Publicizer replaces ReferencePath. Force the compiler to consume the
       rewritten implementation assembly for publicized references. -->
  <Target Name="UsePublicizedImplementationAssemblies" AfterTargets="PublicizeAssemblies">
    <ItemGroup>
      <ReferencePath Update="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.Identity)').Contains('PublicizedAssemblies'))">
        <ReferenceAssembly></ReferenceAssembly>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!-- tML derives a mod's internal ID from the source directory name. Avoid
       producing a second CalamityModPublic package from this checkout. -->
  <Target Name="BuildMod" AfterTargets="Build" Condition="'$(BuildMod)' == 'true'">
    <Warning
      Condition="'$(ActualModSourceDirectoryName)' != '$(ExpectedModSourceDirectoryName)'"
      Text="Skipped .tmod packaging because source directory '$(ActualModSourceDirectoryName)' would create the wrong mod ID. Run tModLoader's -build command with a source path ending in '$(ExpectedModSourceDirectoryName)'."
    />
    <Exec
      Condition="'$(ActualModSourceDirectoryName)' == '$(ExpectedModSourceDirectoryName)'"
      Command="$(BuildLaunch) $(tMLServerPath) -build $(ProjectDir) -eac $(TargetPath) -define &quot;$(DefineConstants)&quot; -unsafe $(AllowUnsafeBlocks) $(ExtraBuildModFlags)"
      WorkingDirectory="$(tModLoaderSteamPath)"
      EnvironmentVariables="$(BuildEnvVars)"
    />
  </Target>
</Project>
